# Public HTTPS origin of the deployed HedgeX Pro frontend.
HEDGEX_FRONTEND_ORIGIN=https://rankflinx-dot.github.io

# Port supplied by the hosting provider, or 8080 locally.
PORT=8080

# Keep false until a separately reviewed demo-only execution service exists.
# This starter intentionally does not implement order placement.
DEMO_EXECUTION_ENABLED=false
